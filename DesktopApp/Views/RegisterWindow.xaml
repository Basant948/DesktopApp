<Window x:Class="DesktopApp.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register" Height="420" Width="380"
        WindowStartupLocation="CenterScreen">
	<StackPanel Margin="24" VerticalAlignment="Center">
		<TextBlock Text="Create an account" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

		<TextBlock Text="Full Name"/>
		<TextBox x:Name="FullNameBox" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

		<TextBlock Text="Username"/>
		<TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

		<TextBlock Text="Email"/>
		<TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

		<TextBlock Text="Password"/>
		<PasswordBox x:Name="PasswordBox" Margin="0,0,0,8"/>

		<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"/>

		<Button Content="Register" Click="RegisterButton_Click" Margin="0,0,0,8"/>
		<Button Content="Already have an account? Login" Click="LoginLink_Click" Background="Transparent" BorderThickness="0"/>
	</StackPanel>
</Window>